NODE_ENV=production

# SERVER ONLY - configure real values in Vercel, never in Git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET=replace_with_a_strong_32_plus_character_secret
JWT_EXPIRES_IN=7d
PUBLIC_ORIGIN=https://your-production-domain.example
CLIENT_URL=https://your-production-domain.example

# Vercel Functions must use persistent object storage for uploads.
STORAGE_DRIVER=vercel_blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional backend-only AI provider settings.
AI_API_KEY=
AI_PROVIDER_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Runtime tuning.
ACADEMIC_YEAR_START_MONTH=6
PROFILE_IMAGE_MAX_SIZE_MB=3
GALLERY_IMAGE_MAX_SIZE_MB=8
ACHIEVEMENT_IMAGE_MAX_SIZE_MB=5
CERTIFICATE_MAX_SIZE_MB=10
MAX_GALLERY_IMAGES_PER_UPLOAD=20
READY_DATABASE_TIMEOUT_MS=3000

# FRONTEND SAFE - visible in the browser bundle.
VITE_API_BASE_URL=/api/v1
VITE_UPLOAD_BASE_URL=
