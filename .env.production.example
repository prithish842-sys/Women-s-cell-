NODE_ENV=production

# SERVER ONLY
PORT=5000
PUBLIC_ORIGIN=https://your-vercel-app.example
CLIENT_URL=https://your-vercel-app.example
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
READY_DATABASE_TIMEOUT_MS=3000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
PM2_INSTANCES=2
DATABASE_URL="postgresql://USER:PASSWORD@MANAGED_DATABASE_HOST:5432/DATABASE?schema=public"
JWT_SECRET=CHANGE_ME_IN_HOSTING_PLATFORM
JWT_EXPIRES_IN=7d

# Backend-only AI provider settings. Configure in hosting secrets, never in Vite variables.
AI_PROVIDER_API_KEY=CHANGE_ME_IN_HOSTING_PLATFORM
GEMINI_API_KEY=CHANGE_ME_IN_HOSTING_PLATFORM_IF_USED
AI_MODEL=gemini-1.5-flash

ACADEMIC_YEAR_START_MONTH=6

PROFILE_IMAGE_MAX_SIZE_MB=3
GALLERY_IMAGE_MAX_SIZE_MB=8
ACHIEVEMENT_IMAGE_MAX_SIZE_MB=5
CERTIFICATE_MAX_SIZE_MB=10
MAX_GALLERY_IMAGES_PER_UPLOAD=20

# Production object storage. Keep credentials server-only.
STORAGE_DRIVER=vercel_blob
BLOB_READ_WRITE_TOKEN=CHANGE_ME_IN_HOSTING_PLATFORM
BLOB_STORE_ID=

# FRONTEND SAFE - visible in the browser bundle.
VITE_API_BASE_URL=/api/v1
VITE_UPLOAD_BASE_URL=
