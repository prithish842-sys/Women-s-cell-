NODE_ENV=development

PORT=5000
CLIENT_URL=http://localhost:5173
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
READY_DATABASE_TIMEOUT_MS=3000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
PM2_INSTANCES=2

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_docker_password
POSTGRES_DB=singa_pen_portal

JWT_SECRET=replace_with_a_strong_local_jwt_secret
JWT_EXPIRES_IN=7d

# Optional backend-only AI provider settings. Do not expose through VITE_*.
AI_PROVIDER_API_KEY=replace_with_backend_ai_provider_key_if_enabled
GEMINI_API_KEY=replace_with_backend_gemini_key_if_enabled
AI_MODEL=gemini-1.5-flash

ACADEMIC_YEAR_START_MONTH=6

# Local-only account setup values. Replace before running seed/setup scripts.
SEED_DEFAULT_PASSWORD=CHANGE_ME_FOR_LOCAL_SEED
WEC_MEMBER_DEFAULT_PASSWORD=CHANGE_ME_FOR_LOCAL_MEMBER_SETUP
ALLOW_DESTRUCTIVE_SEED=false

PROFILE_IMAGE_MAX_SIZE_MB=3
GALLERY_IMAGE_MAX_SIZE_MB=8
ACHIEVEMENT_IMAGE_MAX_SIZE_MB=5
CERTIFICATE_MAX_SIZE_MB=10
MAX_GALLERY_IMAGES_PER_UPLOAD=20

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_UPLOAD_BASE_URL=http://localhost:5000
