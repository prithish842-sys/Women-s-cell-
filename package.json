{
  "name": "singa-pen-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs postgres --tail 50",
    "db:stop": "docker compose stop postgres",
    "predev": "npm run db:up",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server.ts",
    "dev:client": "vite --port 5173",
    "build": "npm run prisma:generate && npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production",
    "stop:pm2": "pm2 stop singa-pen-api",
    "restart:pm2": "pm2 reload singa-pen-api --update-env",
    "seed": "prisma db seed",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-server',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "audit:api": "tsx scripts/api-contract-audit.ts",
    "verify:types": "npm run typecheck",
    "verify:lint": "npm run lint",
    "verify:tests": "npm run test",
    "verify:build": "npm run build",
    "verify:prisma": "npx prisma validate && npx prisma generate && npx prisma migrate status",
    "verify:static": "npm run verify:types && npm run verify:lint && npm run verify:tests && npm run verify:build",
    "verify:runtime": "tsx scripts/verification/runtime-smoke.ts",
    "verify:compatibility": "tsx scripts/verification/compatibility-audit.ts",
    "verify:env": "tsx scripts/verification/env-audit.ts",
    "verify": "npm run verify:prisma && npm run verify:static && npm run verify:compatibility && npm run verify:env",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:setup": "npm run prisma:generate && prisma migrate dev && npm run seed",
    "provision:wec-logins": "tsx scripts/provision-womens-cell-logins.ts",
    "verify:wec-logins": "tsx scripts/verify-womens-cell-logins.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/supertest": "^7.2.1",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "morgan": "^1.11.0",
    "motion": "^13.1.1",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pm2": "^7.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.4.4",
    "supertest": "^7.2.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
